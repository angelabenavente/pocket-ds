{
  "name": "pocket-ds",
  "version": "1.0.0",
  "description": "Pocket DS, a small design system.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelabenavente/pocket-ds.git"
  },
  "files": [
    "src/components",
    "src/styles",
    "styles.d.ts",
    "CHANGELOG.md",
    "!src/components/**/*.stories.tsx",
    "!src/components/**/*.stories.ts",
    "!src/components/**/*.stories.module.scss",
    "!src/components/**/*.test.tsx",
    "!src/components/**/*.test.ts",
    "!src/components/**/*.mdx",
    "!src/components/.gitkeep"
  ],
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "types": "./src/components/index.ts",
  "exports": {
    ".": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./styles": {
      "types": "./src/styles/styles.d.ts",
      "default": "./src/styles/globals.scss"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "audit": "pnpm audit",
    "build-storybook": "storybook build --disable-telemetry",
    "check": "biome check . --no-errors-on-unmatched",
    "check:fix": "biome check . --write",
    "dev": "vite",
    "format:check": "biome format . --no-errors-on-unmatched",
    "generate:foundations": "node scripts/generate-foundation-values.mjs",
    "licenses": "license-checker --summary --excludePrivatePackages",
    "licenses:unknown": "node scripts/check-unknown-licenses.mjs",
    "lint": "biome lint . --no-errors-on-unmatched",
    "prebuild-storybook": "pnpm generate:foundations",
    "precommit": "sh scripts/pre-commit-check.sh",
    "predev": "pnpm generate:foundations",
    "prepare": "husky",
    "prepublishOnly": "pnpm run typecheck && pnpm test",
    "prestorybook": "pnpm generate:foundations",
    "pretsc": "pnpm generate:foundations",
    "pretypecheck": "pnpm generate:foundations",
    "quality": "sh scripts/run-quality.sh",
    "chromatic": "chromatic --exit-zero-on-changes",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "test": "vitest run --project=unit",
    "pretest-storybook": "playwright install chromium",
    "test-storybook": "vitest run --project=storybook",
    "pretest-storybook:coverage": "playwright install chromium",
    "test-storybook:coverage": "vitest run --project=storybook --coverage",
    "tsc": "tsc -b",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.77.0"
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@chromatic-com/storybook": "^5.3.1",
    "@fontsource/inter": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.5.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "chromatic": "^18.10.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "license-checker": "^25.0.1",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.104.0",
    "storybook": "^10.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
